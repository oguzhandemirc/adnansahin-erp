{
  "expo": {
    "name": "Adnan Şahin Yönetim",
    "slug": "adnansahin-yonetim",
    "owner": "demircioguzhan",
    "scheme": "adnansahin-yonetim",
    "version": "1.2.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#161C2B",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#161C2B"
    },
    "ios": {
      "bundleIdentifier": "com.etkiliyazilim.adnansahin.yonetim",
      "buildNumber": "1",
      "appleTeamId": "Z2348KHLXK",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.etkiliyazilim.adnansahin.yonetim",
      "versionCode": 3,
      "allowBackup": false,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#161C2B"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#161C2B"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "com.google.android.c2dm.permission.RECEIVE",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "tr",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "./plugins/withPatronImza.js",
      "./plugins/withBildirimBaglantisi.js",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Uygulama, siz mikrofon düğmesine bastığınızda konuşmanızı dinleyerek yeni sipariş formunu doldurur; örneğin \"Akın Tekstil, 500 metre siyah ribana\" dediğinizde müşteri, ürün, renk ve miktar alanlarına yazar ve ses kaydı tutmaz.",
          "speechRecognitionPermission": "Uygulama, konuşmanızı yeni sipariş formuna yazmak için Apple'ın konuşma tanıma hizmetini kullanır ve bunun için sesinizi Apple'a gönderebilir; örneğin \"500 metre siyah ribana\" dediğinizde ürün, renk ve miktar alanlarını doldurur.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "722714fd-af55-49d5-9d5e-4df05c632a6a"
      }
    }
  }
}
