# Patron bulutu sunucusu ortam şablonu — gerçek değerler .env'e (repoya girmez, chmod 600).
# ÜÇ URL, AYNI DB, ÜÇ AYRI ROL. DB adı yerelde yalnız *_test; tekserp_fabrika_* ASLA.
# TEK veritabanı (Adnan, tek tesis). Göç rolü (tablo sahibi): yalnız migrate deploy · scripts/db-rolleri.ts · scripts/tesis.ts — sunucu bununla BAĞLANMAZ
GOC_DATABASE_URL='postgresql://<goc_rolu>:<parola>@localhost:5432/<ad>_test?schema=public'
# Uygulama rolü (hesap API'si) ve eşitleme rolü (fabrika kanalı) — NOSUPERUSER NOBYPASSRLS; db-rolleri.ts kurar
DATABASE_URL='postgresql://<ad>_app:<parola>@localhost:5432/<ad>_test?schema=public'
ESITLEME_DATABASE_URL='postgresql://<ad>_sync:<parola>@localhost:5432/<ad>_test?schema=public'
PORT=4620
BIND=127.0.0.1
# TOTP sırlarının sarma anahtarı (patron-totp.key, 0600) — repoya girmez
ANAHTAR_DIZINI=anahtarlar
# Vekil arkasında istemci IP başlığı — yalnız güvenilen kenar ağından (varsayılan Cloudflare aralıkları) gelen bağlantıda okunur
# VEKIL_IP_BASLIGI=cf-connecting-ip
# GUVENILIR_VEKIL_AGLARI=<CIDR,…; verilmezse Cloudflare aralıkları>
# İç vekil (Adnan: Caddy, adnan-ag) ağı: güven kararı X-Forwarded-For'un son halkasına göre
# IC_VEKIL_AGLARI=172.31.250.0/28
# Oturum/giriş — varsayılanlar gösterildi
# OTURUM_BOSTA_SAAT=168
# OTURUM_AZAMI_GUN=30
# GIRIS_ESIGI=5
# KILIT_DK=15
# GIRIS_HESAP_TAVANI=50     # fabrika hesabı: 24 sa içinde bu kadar başarısız giriş → hesap geçici kilit
# GIRIS_HESAP_KILIT_DK=60
# FABRIKA_BAYATLIK_GUN=7    # son kullanıcı kümesi gönderimi bundan eskiyse yeni giriş 503 FABRIKA_BAGLANTISI_YOK
# GIRIS_HIZ_DK=20
# API_HIZ_DK=600            # /api geneli IP başına dakikalık sınır
# OTURUM_RED_HIZ_DK=30      # IP başına dakikada geçersiz Bearer; aşılınca oturumlu istekler DB'ye inmeden 429
# Fabrika kanalı IP başına dakikalık sınır · claim süreleri · bakım aralığı
# V1_HIZ_DK=600
# GELEN_KUTUSU_CLAIM_DK=10
# RAPOR_CLAIM_DK=5
# BAKIM_ARALIGI_SN=60
# Budama (gün): oturum · işlem kimliği · paket makbuzu · rapor sonucu · denetim (başarısız giriş / diğer)
# OTURUM_SAKLAMA_GUN=30
# ISLEM_SAKLAMA_GUN=30
# PAKET_SAKLAMA_GUN=30
# RAPOR_SONUC_SAKLAMA_GUN=30
# DENETIM_GIRIS_SAKLAMA_GUN=90
# DENETIM_SAKLAMA_GUN=730
# Bildirimler (B5): kapali (varsayılan, bugünkü davranış) | sahte (ağ yok) | gercek (Expo + web push)
# BILDIRIM_KIPI=kapali
# BILDIRIM_ARALIGI_SN=30
# BILDIRIM_SAKLAMA_GUN=90
# gercek kipte zorunlu (VAPID "sub"); anahtar çifti ANAHTAR_DIZINI/patron-vapid.json (0600, ilk açılışta üretilir)
# BILDIRIM_VAPID_KONU=mailto:<adres>
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# EXPO_MAKBUZ_URL=https://exp.host/--/api/v2/push/getReceipts
# Expo "enhanced push security" belirteci — SIR, repoya girmez
# EXPO_ERISIM_BELIRTECI=
# Telefon push kapısı (F5): kapali (varsayılan = bugünkü davranış) | acik. Yük İÇERİKSİZ (başlık + kimlikler);
# yalnız gercek kipte ve EXPO_ERISIM_BELIRTECI varken etkinleşir, yoksa kapalı kalır (tek satır günlük).
# BILDIRIM_NATIVE_PUSH=kapali
